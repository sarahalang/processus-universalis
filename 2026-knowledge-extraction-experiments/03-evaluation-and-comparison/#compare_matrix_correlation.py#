import pandas as pd
import numpy as np
from scipy.spatial.distance import pdist, squareform
from scipy.stats import spearmanr
import os

# Paths
BASE_DIR = os.path.dirname(os.path.abspath(__file__))
AUTO_MATRIX_PATH = os.path.join(BASE_DIR, "../data/automated_procedural_matrix.csv")
EXPERT_MATRIX_PATH = os.path.join(BASE_DIR, "../../2026-analyses/data/processus_matrix.csv")
RESULTS_PATH = os.path.join(BASE_DIR, "../data/correlation_results.txt")

def calculate_closeness():
    # 1. Load Data
    auto_df = pd.read_csv(AUTO_MATRIX_PATH).set_index('text_id').sort_index()
    expert_df = pd.read_csv(EXPERT_MATRIX_PATH).set_index('text_id').sort_index()

    # Align indices
    common_ids = auto_df.index.intersection(expert_df.index)
    
    # Extract only the 11 procedure columns for Auto
    auto_data = auto_df.loc[common_ids].drop(columns=['total_steps', 'completeness_score']).astype(float)
    
    # DEBUGGING START
    print("--- DEBUGGING EXPERT_DF ---")
    print("expert_df.head():")
    print(expert_df.head().to_string())
    print("expert_df.columns (after set_index('text_id')):")
    print(expert_df.columns.to_list())
    
    debug_slice_df = expert_df.loc[common_ids]
    print("
expert_df.loc[common_ids].head():")
    print(debug_slice_df.head().to_string())
    print("
expert_slice_df.columns:") # Corrected variable name for clarity
    print(debug_slice_df.columns.to_list())
    
    print("
expert_df.loc[common_ids].iloc[:, 0:10].head():")
    print(debug_slice_df.iloc[:, 0:10].head().to_string())
    
    print("
expert_df.loc[common_ids].iloc[:, 7:].head():")
    target_slice = debug_slice_df.iloc[:, 7:]
    print(target_slice.head().to_string())
    
    print("
Data types of expert_df.loc[common_ids].iloc[:, 7:] before astype(float):")
    print(target_slice.dtypes.to_string())
    
    # Find the problematic value
    for col in target_slice.columns:

        if target_slice[col].dtype == 'object': 
            print(f"
Column '{col}' has object dtype. Unique values:")
            print(target_slice[col].unique())
            problematic_values = target_slice[col][target_slice[col].apply(lambda x: isinstance(x, str) and not x.replace('.', '', 1).isdigit() if isinstance(x, str) else False)]
            if not problematic_values.empty:
                print(f"Problematic string values in '{col}':")
                print(problematic_values.unique())
    print("--- DEBUGGING END ---")
    
    # For Expert, select only binary columns (from index 7 onwards, skipping metadata)
    # The file has 38 columns, first 8 are metadata.
    expert_data = expert_df.loc[common_ids].iloc[:, 7:].astype(float)

    # 2. Calculate Distance Matrices (Jaccard)
    auto_dist = pdist(auto_data.values, metric='jaccard')
    expert_dist = pdist(expert_data.values, metric='jaccard')

    # 3. Correlation (Spearman)
    corr, p_value = spearmanr(auto_dist, expert_dist)

    # 4. Write results to file
    with open(RESULTS_PATH, 'w') as f:
        f.write(f"--- Matrix Correlation Analysis ---
")
        f.write(f"Number of common documents: {len(common_ids)}
")
        f.write(f"Spearman Correlation: {corr:.4f}
")
        f.write(f"P-value: {p_value:.4f}

")
        
        f.write("Note: Automated used 11 normalized categories. Expert used 31 granular categories.
")

if __name__ == "__main__":
    calculate_closeness()
